# Copy this file to .env and fill in values for local development.
# Never commit .env — it is git-ignored.

# Application
APP_NAME=jobregator
IMAGE_TAG=latest
PORT=8080

# Container registry (used by `make package`)
REGISTRY=ghcr.io/rdlucas2

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Remotive API (https://remotive.com/api-documentation — no key needed)
REMOTIVE_CATEGORIES=devops,software-development,data,qa

# Jobicy API (https://jobicy.com/jobs-rss-feed — no key needed)
JOBICY_INDUSTRIES=admin,engineering,dev
JOBICY_GEO=usa

# Scraper settings
LOOKBACK_HOURS=48

# Anthropic API (for MCP enrichment server)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
ENABLE_ENRICHMENT=true
# Which model answers the bounded questions (fit score, experience level,
# remote policy, job type). "jev" requires TYPESAFE_API_KEY (signups currently
# closed); "laya" requires LAYA_BASE_URL; "claude" needs no TypeSafe credential.
ENRICHMENT_TYPED_PROVIDER=claude
TYPESAFE_API_KEY=
# Pinned rather than "jev-latest": routing branches on probability thresholds.
JEV_MODEL=jev-1.13.0
# "laya" = open-source Jev-compatible server you run yourself (no cloud key).
# Set ENRICHMENT_TYPED_PROVIDER=laya and point LAYA_BASE_URL at laya-serve; see
# docs/running-laya-locally.md. LAYA_API_KEY only if laya-serve was started with one.
LAYA_BASE_URL=http://host.docker.internal:8000
LAYA_API_KEY=
LAYA_MODEL=laya

# Discord notifications
DISCORD_WEBHOOK_URL=
FIT_SCORE_THRESHOLD=0.7

# SonarQube (used by `make sonar-scan`)
# Generate a token at http://localhost:9000 after running `make sonar-start`
SONAR_TOKEN=
